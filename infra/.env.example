# Copy to infra/.env and fill in real values. infra/.env is git-ignored.
#   cp infra/.env.example infra/.env
# Nothing in this file is a real secret. Never commit infra/.env.

# ---------- database ----------
POSTGRES_DB=patipp
POSTGRES_USER=patipp
# Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=replace_me_with_a_local_password
POSTGRES_PORT=5432

# ---------- backend ----------
# PATIPP always uses 8081 for the API and 3001 for the web app. 8080 and 3000 are
# left free for other local projects. Changing the web port means changing
# PATIPP_CORS_ORIGINS below too, or the browser will fail preflight.
PATIPP_PORT=8081
# Read by Spring via application.yml placeholders.
PATIPP_DB_URL=jdbc:postgresql://localhost:5432/patipp
PATIPP_DB_USER=patipp
PATIPP_DB_PASSWORD=replace_me_with_a_local_password

# JWT signing key for HS256. MUST be at least 32 bytes of real entropy.
# Generate one: openssl rand -base64 48
# The application refuses to start if this is missing, short, or left at the placeholder.
PATIPP_JWT_SECRET=replace_me_openssl_rand_base64_48

PATIPP_JWT_ACCESS_TTL_MINUTES=15
PATIPP_JWT_REFRESH_TTL_DAYS=30

# Comma-separated exact origins. No wildcards: credentials are sent cross-origin.
PATIPP_CORS_ORIGINS=http://localhost:3001

# ---------- ai (Phase 8 - unused until then) ----------
# none | anthropic | openai | local
# "none" selects the Noop adapter: the application is fully functional without a key.
PATIPP_AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
